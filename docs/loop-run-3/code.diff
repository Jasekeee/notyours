     res.send(page({ title: note.title, user: req.user, active: 'notes', body }));
   });
 
+  // Copies one of your own notes. Scoped to the owner: someone else's note id is a 404, never a copy.
+  r.post('/notes/:id/duplicate', requireLogin, (req, res) => {
+    const id = parseId(req.params.id);
+    const note = id === null ? undefined : db.get(`${NOTE_SELECT} WHERE n.id = ? AND n.owner_id = ?`, [id, req.user.id]);
