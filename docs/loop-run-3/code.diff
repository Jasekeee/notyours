diff --git a/vitest.config.js b/vitest.config.js
index ba5475a..4dd2ee7 100644
--- a/vitest.config.js
+++ b/vitest.config.js
@@ -1,7 +1,24 @@
 // Demo-only test config: `npx vitest run --root demo`.
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
 import { defineConfig } from 'vitest/config';
 
+const here = path.dirname(fileURLToPath(import.meta.url));
+
+// test/boundaries.test.js imports `../../src/schemas.ts`, which resolves when this folder lives at
+// notyours/demo. In a standalone checkout, point that import at the notyours repo instead:
+// $NOTYOURS_ROOT, or the repo that the symlinked node_modules belongs to.
+const alias = [];
+if (!fs.existsSync(path.join(here, '..', 'src', 'schemas.ts'))) {
+  const nyRoot = process.env.NOTYOURS_ROOT
+    ?? (fs.existsSync(path.join(here, 'node_modules')) ? path.dirname(fs.realpathSync(path.join(here, 'node_modules'))) : null);
+  const schemas = nyRoot && path.join(nyRoot, 'src', 'schemas.ts');
+  if (schemas && fs.existsSync(schemas)) alias.push({ find: '../../src/schemas.ts', replacement: schemas });
+}
+
 export default defineConfig({
+  resolve: { alias },
   test: {
     include: ['test/**/*.test.js'],
   },
