+    if (noteCache.size > NOTE_CACHE_MAX) noteCache.delete(noteCache.keys().next().value);
+  }
+  res.send(page(req, entry.title, entry.html.split(CSRF_PLACEHOLDER).join(esc(req.session.csrf))));
 });
 
