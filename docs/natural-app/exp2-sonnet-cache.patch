+app.get('/notes/:id', requireLogin, (req, res) => {
+  const id = Number(req.params.id);
+  const origin = `${req.protocol}://${req.get('host')}`;
+  const key = `${req.user.id}:${id}:${origin}`;
+  let entry = Number.isInteger(id) ? noteCache.get(key) : undefined;
+  if (entry) { noteCache.delete(key); noteCache.set(key, entry); } // refresh LRU position
