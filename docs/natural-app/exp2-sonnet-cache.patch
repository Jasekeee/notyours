+
+// In-memory cache of rendered note-page content (small LRU). Keyed by viewer + note + origin, so one
+// user can never be served another's entry; the per-session CSRF token is a placeholder filled in per request.
+// Any write to a note must call dropNoteCache(id).
+const NOTE_CACHE_MAX = 500;
+const noteCache = new Map();
+const CSRF_PLACEHOLDER = '@@csrf-' + rand(12) + '@@';
+const dropNoteCache = (noteId) => {
+  const suffix = `:${Number(noteId)}:`;
+  for (const k of noteCache.keys()) if (k.includes(suffix)) noteCache.delete(k);
+};
 const notFound = (req, res) => res.status(404).send(page(req, 'Not found', '<h1>Not found</h1><p><a href="/">Back to notes</a></p>'));
 
