+const NOTE_CACHE_MAX = 500;
+const noteCache = new Map(); // note id -> { origin, html }
+function cacheNote(id, origin, html) {
+  if (noteCache.size >= NOTE_CACHE_MAX) noteCache.delete(noteCache.keys().next().value);
+  noteCache.set(id, { origin, html });
