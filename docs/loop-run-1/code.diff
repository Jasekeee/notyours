+describe('duplicate note', () => {
+  it('owner sees a Duplicate button and gets an independent copy', async () => {
+    const req = client();
+    await req('POST', '/signup', { name: 'Dana', email: 'dana@jotter.test', password: 'dana-pass-123' }); // notyours:allow-secret (fake test value)
+    const created = await req('POST', '/notes/new', { title: 'Recipe', body: 'flour\n& <sugar>' });
+    const id = Number(created.location.split('/').pop());
+
+    const view = await req('GET', `/notes/${id}`);
+    expect(view.text).toContain(`action="/notes/${id}/duplicate"`);
+
+    const dup = await req('POST', `/notes/${id}/duplicate`);
+    expect(dup.status).toBe(302);
+    const copyId = Number(dup.location.split('/').pop());
+    expect(copyId).toBeGreaterThan(id);
+
+    const copy = await req('GET', dup.location);
+    expect(copy.status).toBe(200);
+    expect(copy.text).toContain('Copy of Recipe');
+    expect(copy.text).toContain('flour\n&amp; &lt;sugar&gt;');
+
+    const list = await req('GET', '/notes');
+    expect(list.text).toContain(`href="/notes/${id}"`);
+    expect(list.text).toContain(`href="/notes/${copyId}"`);
+  });
+
+  it('long titles stay within the 200-character limit', async () => {
+    const req = client();
+    await req('POST', '/signup', { name: 'Eve', email: 'eve@jotter.test', password: 'eve-pass-1234' }); // notyours:allow-secret (fake test value)
+    const created = await req('POST', '/notes/new', { title: 'x'.repeat(200), body: 'b' });
+    const dup = await req('POST', `${created.location}/duplicate`);
+    const json = await req('GET', `/api/notes/${dup.location.split('/').pop()}`);
+    expect(JSON.parse(json.text).title).toBe(`Copy of ${'x'.repeat(192)}`);
+  });
+
+  it("Bob cannot duplicate Alice's note into his account, and sees no button for it", async () => {
+    const bob = await loginAs(BOB);
+    const view = await bob('GET', '/notes/1001'); // readable only because of SEEDED BUG #1
+    expect(view.text).not.toContain('/duplicate');
+
+    const dup = await bob('POST', '/notes/1001/duplicate');
+    expect(dup.status).toBe(404);
+    expect(dup.text).not.toContain(ALICE.token);
+    const list = await bob('GET', '/notes');
+    expect(list.text).not.toContain(ALICE.token);
+    expect(list.text).not.toContain('Travel documents');
+  });
+
+  it('guests are redirected to /login and bad ids are 404', async () => {
+    const guest = client();
+    const res = await guest('POST', '/notes/1001/duplicate');
+    expect(res.status).toBe(302);
+    expect(res.location).toMatch(/^\/login\?next=/);
+    const bob = await loginAs(BOB);
+    expect((await bob('POST', '/notes/abc/duplicate')).status).toBe(404);
+    expect((await bob('POST', '/notes/999999/duplicate')).status).toBe(404);
+  });
+});
