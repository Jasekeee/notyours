+    const list = await bob('GET', '/notes');
+    expect(list.text).not.toContain(ALICE.token);
+    expect((await bob('POST', '/notes/abc/duplicate')).status).toBe(404);
+
+    const guest = await client()('POST', '/notes/1001/duplicate');
+    expect(guest.status).toBe(302);
+    expect(guest.location).toMatch(/^\/login\?next=/);
+  });
